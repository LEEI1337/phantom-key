# Environment Configuration Template
# Kopiere diese Datei zu .env und passe die Werte an

# ===========================================
# API & Server Settings
# ===========================================
API_PORT=3000
WS_PORT=3001
LOG_LEVEL=info
DEBUG_MODE=false

# ===========================================
# Proxmox VE Configuration
# ===========================================
PROXMOX_URL=https://pve.local:8006
PROXMOX_TOKEN=APIUSER@pam!TOKENID
PROXMOX_SECRET=YOUR_SECRET_HERE
PROXMOX_NODE=pve
PROXMOX_INSECURE=true

# ===========================================
# Docker Configuration
# ===========================================
DOCKER_HOST=unix:///var/run/docker.sock

# ===========================================
# OpenMediaVault Configuration
# ===========================================
OMV_URL=http://omv.local
OMV_USERNAME=admin
OMV_PASSWORD=your_password

# ===========================================
# pfSense Configuration
# ===========================================
PFSENSE_URL=https://pfsense.local
PFSENSE_KEY=YOUR_API_KEY
PFSENSE_SECRET=YOUR_API_SECRET
PFSENSE_INSECURE=true

# ===========================================
# Home Assistant Configuration
# ===========================================
HA_URL=http://homeassistant.local:8123
HA_TOKEN=YOUR_LONG_LIVED_ACCESS_TOKEN

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL=redis://redis:6379

# ===========================================
# MQTT Configuration
# ===========================================
MQTT_BROKER=mqtt://mosquitto:1883
MQTT_USER=
MQTT_PASS=

# ===========================================
# Database Configuration
# ===========================================
DB_PATH=/data/timeseries.db
RETENTION_HOURS=48

# ===========================================
# GPU Monitoring (optional)
# ===========================================
GPU_ENABLED=false
NVML_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libnvidia-ml.so
